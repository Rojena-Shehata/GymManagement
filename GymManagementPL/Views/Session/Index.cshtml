
@model IEnumerable<SessionViewModel>
@{
    ViewData["Title"] = "Sessions";

    string colorStatus;
    string wordStatus;
}


@if (TempData["SuccessMessage"] != null)
{
    <div id="Alert" class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
else if (TempData["ErrorMessage"] != null)
{
    <div id="Alert" class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container">
    <header class="d-flex justify-content-between mt-5 mb-4 align-items-center">
        <div>
            <h2 class="text-primary-color mb-0">@viewLocalizer["sessionsTitle"]</h2>
            <p class="text-muted">@viewLocalizer["sessionsSubtitle"]</p>
        </div>
        <a asp-controller="Session" asp-action="Create" class="btn btn-fill fw-medium rounded-pill px-4 py-3">
            <i class="bi bi-plus-lg me-2"></i>@viewLocalizer["addSession"]
        </a>
    </header>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var session in Model)
            {
                @if (session.Status == "Ongoing")
                {
                    colorStatus = "bg-success";
                    wordStatus = viewLocalizer["statusOngoing"].Value;
                }
                else if (session.Status == "Upcoming")
                {
                    colorStatus = "bg-primary";
                    wordStatus = viewLocalizer["statusUpcoming"].Value;

                }
                else
                {
                    colorStatus = "bg-secondary";
                    wordStatus = viewLocalizer["statusCompleted"].Value;

                }
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 session-card">
                        <!-- If Session Ongoing  bg-success -->
                        <!-- If Session Upcoming  bg-primary -->
                        <!-- If Session Completed  bg-secondary -->
                        <div class="card-header text-white py-3 @colorStatus">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">
                                    <i class="bi bi-calendar-event me-2"></i>@session.CategoryName
                                </h5>
                                <span class="badge bg-light text-dark">
                                    @wordStatus
                                </span>
                            </div>
                        </div>
                        <div class="card-body">
                            <p class="text-muted mb-3">@session.Description</p>

                            <div class="session-info mb-3">
                                <div class="info-item mb-2">
                                    <i class="bi bi-person-circle text-primary-color me-2"></i>
                                    <strong>@viewLocalizer["theTrainer"]:</strong> @session.TrainerName
                                </div>
                                <div class="info-item mb-2">
                                    <i class="bi bi-calendar3 text-primary-color me-2"></i>
                                    <strong>@viewLocalizer["date"]:</strong> @session.DateDisplay
                                </div>
                                <div class="info-item mb-2">
                                    <i class="bi bi-clock text-primary-color me-2"></i>
                                    <strong>@viewLocalizer["time"]:</strong> @session.TimeRangeDisplay
                                </div>
                                <div class="info-item mb-2">
                                    <i class="bi bi-hourglass-split text-primary-color me-2"></i>
                                    <strong>@viewLocalizer["duration"]:</strong> @session.Duration.Days @viewLocalizer["days"]
                                </div>
                                <div class="info-item">
                                    <i class="bi bi-people text-primary-color me-2"></i>
                                    <strong>@viewLocalizer["capacity"]:</strong> @session.AvailableSlots/@session.Capacity @viewLocalizer["slots"]
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-white border-0">
                            <div class="d-grid gap-2">
                                <a asp-action="Details" asp-route-id="@session.Id" class="btn btn-outline btn-sm">
                                    <i class="bi bi-eye me-1"></i>@viewLocalizer["viewDetails"]
                                </a>
                                <div class="d-flex gap-2">
                                    <a asp-action="Edit" asp-route-id="@session.Id" class="btn btn-outline btn-sm flex-fill">
                                        <i class="bi bi-pencil me-1"></i>@viewLocalizer["edit"]
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@session.Id" class="btn btn-outline text-danger btn-sm flex-fill">
                                        <i class="bi bi-trash me-1"></i>@viewLocalizer["delete"]
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-calendar-x display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">@viewLocalizer["noSessions"]</h4>
            <p class="text-muted">@viewLocalizer["addFirstSession"]</p>
        </div>
    }
</div>

@section Scripts {
    
<partial name="_AlertBoxScript" />
}

