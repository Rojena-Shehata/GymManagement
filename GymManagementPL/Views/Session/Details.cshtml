@model SessionViewModel
@{
    ViewData["Title"] = $"Session Details";

    string colorStatus;
    string wordStatus;
    @if (Model.Status == "Ongoing")
    {
        colorStatus = "bg-success";
        wordStatus = viewLocalizer["statusOngoing"].Value;
    }
    else if (Model.Status == "Upcoming")
    {
        colorStatus = "bg-primary";
        wordStatus = viewLocalizer["statusUpcoming"].Value;

    }
    else
    {
        colorStatus = "bg-secondary";
        wordStatus = viewLocalizer["statusCompleted"].Value;

    }
}


<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0">
                <!-- If Session Ongoing  bg-success -->
                <!-- If Session Upcoming  bg-primary -->
                <!-- If Session Completed  bg-secondary -->
                <div class="card-header  text-white text-center py-4 @colorStatus">
                    <i class="bi bi-calendar-event display-4 mb-3"></i>
                    <h2 class="mb-2">@Model.CategoryName</h2>
                    <span class="badge bg-light text-dark fs-6">@wordStatus</span>
                </div>

                <div class="card-body p-4">
                    <!-- Description -->
                    <div class="mb-4 p-3 bg-light rounded">
                        <h6 class="text-primary-color mb-2">
                            <i class="bi bi-file-text me-2"></i>@viewLocalizer["description"]
                        </h6>
                        <p class="mb-0">@Model.Description</p>
                    </div>

                    <!-- Session Details -->
                    <div class="row g-4">
                        <div class="col-md-6">
                            <div class="detail-box p-3 border rounded">
                                <div class="d-flex align-items-center">
                                    <div class="icon-box me-3">
                                        <i class="bi bi-person-circle text-primary-color fs-3"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block">@viewLocalizer["theTrainer"]</small>
                                        <strong>@Model.TrainerName</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="detail-box p-3 border rounded">
                                <div class="d-flex align-items-center">
                                    <div class="icon-box me-3">
                                        <i class="bi bi-people text-primary-color fs-3"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block">@viewLocalizer["capacity"]</small>
                                        <strong>@Model.AvailableSlots / @Model.Capacity @viewLocalizer["slots"]</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="detail-box p-3 border rounded">
                                <div class="d-flex align-items-center">
                                    <div class="icon-box me-3">
                                        <i class="bi bi-calendar-check text-primary-color fs-3"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block">@viewLocalizer["startTime"]</small>
                                        <strong>@Model.StartDate</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="detail-box p-3 border rounded">
                                <div class="d-flex align-items-center">
                                    <div class="icon-box me-3">
                                        <i class="bi bi-calendar-x text-primary-color fs-3"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block">@viewLocalizer["endTime"]</small>
                                        <strong>@Model.EndDate</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="detail-box p-3 border rounded bg-light">
                                <div class="d-flex align-items-center">
                                    <div class="icon-box me-3">
                                        <i class="bi bi-hourglass-split text-primary-color fs-3"></i>
                                    </div>
                                    <div>
                                        <small class="text-muted d-block">@viewLocalizer["duration"]</small>
                                        <strong class="text-primary-color fs-5">
                                            @Model.Duration.Hours @viewLocalizer["hours"]  @Model.Duration.Minutes @viewLocalizer["minutes"]
                                        </strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-footer bg-white border-0 p-4">
                    <div class="d-flex justify-content-between gap-2">
                        <a asp-action="Index" class="btn btn-outline flex-fill">
                            <i class="bi bi-arrow-left me-1"></i>@viewLocalizer["backToList"]
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

