@model UpdateSessionViewModel

@{
    ViewData["Title"] = "Edit Session";
}


<div class="container mt-4">
    <header class="mb-4">
        <h3 class="text-primary-color">@viewLocalizer["editSession"]</h3>
        <p class="text-muted">@viewLocalizer["updateSessionInfo"]</p>
    </header>
    @Html.ValidationMessage("Data","Check entered data")
    <form asp-action="Edit" method="post">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">

                        <!-- Session Information -->
                        <div class="section-header mb-3">
                            <h5 class="text-primary fw-bold">@viewLocalizer["sessionInformation"]</h5>
                            <hr class="mt-2">
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="TrainerId" class="form-label fw-semibold">
                                    @viewLocalizer["theTrainer"] <span class="text-danger">*</span>
                                </label>
                                <select asp-for="TrainerId" asp-items="@ViewBag.Trainers" class="form-select">
                                    <option value="">@viewLocalizer["selectTrainer"]</option>
                                </select>
                                <span asp-validation-for="TrainerId" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-semibold">
                                    @viewLocalizer["description"] <span class="text-danger">*</span>
                                </label>
                                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Date & Time -->
                        <div class="section-header mb-3">
                            <h5 class="text-primary fw-bold">@viewLocalizer["dateTime"]</h5>
                            <hr class="mt-2">
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="StartDate" class="form-label fw-semibold">
                                    @viewLocalizer["startDateTime"] <span class="text-danger">*</span>
                                </label>
                                <input asp-for="StartDate" type="datetime-local" class="form-control" />
                                <span asp-validation-for="StartDate" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="EndDate" class="form-label fw-semibold">
                                    @viewLocalizer["endDateTime"] <span class="text-danger">*</span>
                                </label>
                                <input asp-for="EndDate" type="datetime-local" class="form-control" />
                                <span asp-validation-for="EndDate" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline">
                                <i class="bi bi-arrow-left me-1"></i>@viewLocalizer["cancel"]
                            </a>
                            <button type="submit" class="btn btn-fill">
                                <i class="bi bi-check-lg me-1"></i>@viewLocalizer["updateSession"]
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
