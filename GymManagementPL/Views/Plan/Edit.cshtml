@model UpdatePlanViewModel
@{
    ViewData["Title"] = $"Edit {Model.PlanName}";
}


<div class="container mt-4">
    <header class="mb-4">
        <h3 class="text-primary-color"></h3>
        <p class="text-muted">@viewLocalizer["updatePlan"]</p>
    </header>

    @Html.ValidationMessage("DataMissed", new { @class = "text-danger" })

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <form asp-action="Edit" asp-controller="plan" method="post">
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="PlanName" class="form-label fw-semibold">
                                    @viewLocalizer["planName"] <span class="text-danger">*</span>
                                </label>
                                <input asp-for="PlanName" class="form-control" readonly />
                            </div>

                            <div class="col-md-6">
                                <label asp-for="DurationDays" class="form-label fw-semibold">
                                    @viewLocalizer["durationDays"] <span class="text-danger">*</span>
                                </label>
                                <input asp-for="DurationDays" type="number" class="form-control" />
                                <small class="text-muted">@viewLocalizer["durationDaysHint"]</small>
                                <span asp-validation-for="DurationDays" class="text-danger d-block"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Price" class="form-label fw-semibold">
                                    @viewLocalizer["price"] <span class="text-danger">*</span>
                                </label>
                                <input asp-for="Price" type="number" step="0.01" class="form-control" />
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Description" class="form-label fw-semibold">
                                    @viewLocalizer["description"] <span class="text-danger">*</span>
                                </label>
                                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline">
                                <i class="bi bi-arrow-left me-1"></i>@viewLocalizer["cancel"]
                            </a>
                            <button type="submit" class="btn btn-fill">
                                <i class="bi bi-check-lg me-1"></i>@viewLocalizer["updatePlan"]
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts
{

    <partial name="_ValidationScriptsPartial" />
}