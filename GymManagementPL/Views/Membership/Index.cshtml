
@model IEnumerable<MembershipViewModel>
@{
    ViewData["Title"] = "Memberships";
}

<div class="container-fluid">
    <header class="bg-primary text-white rounded-3 p-4 shadow-sm mt-5 mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="mb-1 fw-semibold">
                    @viewLocalizer["activeMembershipsHeader"]</h2>
                <p class="mb-0 text-light opacity-75">@viewLocalizer["activeMembershipsSubtitle"]</p>
            </div>
            <div class="col text-end">
                <a asp-action="Create" class="btn btn-light">
                    <i class="fas fa-plus"></i> @viewLocalizer["newMembership"]
                </a>
            </div>
        </div>
    </header>
    @if (TempData["SuccessMessage"]  is  not null)
    {
     
    <div id="Alert" class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>

    }
    @if(TempData["ErrorMessage"]  is not null)
    {
    
    <div id="Alert" class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>

    }
        <div class="card">
            <div class="card-body">

            @if (Model is not null && Model.Any())
            {
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>@viewLocalizer["member"]</th>
                            <th>@viewLocalizer["plan"]</th>
                            <th>@viewLocalizer["startDate"]</th>
                            <th>@viewLocalizer["endDate"]</th>
                            <th>@viewLocalizer["actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var membership in @Model)
                        {


                            <tr>
                                <td>@membership.MemberName</td>
                                <td>@membership.PlanName</td>
                                <td>@membership.StartDate.ToString("MMM dd, yyyy")</td>
                                <td>@membership.EndDate.ToString("MMM dd, yyyy")</td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <form method="post" asp-action="Cancel" class="m-0">
                                            <input value="@membership.MemberId" name="memberId" hidden readonly />
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <i class="fas fa-times"></i> @viewLocalizer["cancel"]
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                }
            else
            {
                
            
            <div class="text-center py-5">
                    <i class="bi bi-person-workspace display-1 text-muted"></i>
                    <h4 class="mt-3 text-muted">@viewLocalizer["noActiveMembershipsTitle"]</h4>
                </div>
            }
            </div>
        </div>
    
</div>
