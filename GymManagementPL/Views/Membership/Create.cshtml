@model AddMembershipViewModel 


@inject IViewLocalizer viewLocalizer


@{
    ViewData["Title"] = "Add new Membership";
}
@if (ViewBag.Errors  is   not null)
{
    <div id="Alert" class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @ViewBag.Errors
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-primary text-white text-center rounded-top-4">
                    <h4>@viewLocalizer["addMembershipTitle"]</h4>
                </div>
                <div class="card-body">
                    <form  asp-action="Create" method="post" asp-controller="Membership">

                        <div class="mb-3">
                            <label asp-for="MemberId" class="form-label">@viewLocalizer["member"]<span class="text-danger">*</span></label>
                            <select class="form-select" asp-for="MemberId" asp-items="@ViewBag.Members">
                                <option value="">-- @viewLocalizer["selectMember"] --</option>
                                
                            </select>
                            <span asp-validation-for="MemberId"    class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">@viewLocalizer["plan"]<span class="text-danger">*</span></label>
                            <select class="form-select" asp-for="PlanId"   asp-items="@ViewBag.Plans">
                                <option value="">-- @viewLocalizer["selectPlan"] --</option>
                            </select>
                            <span asp-validation-for="PlanId" class="text-danger"></span>
                        </div>
                        <div>
                            <label asp-for="StartDate" class="form-label">@viewLocalizer["startDate"]</label>
                            <input asp-for="StartDate" 
                            value="@(Model  is null||Model.StartDate==DateTime.MinValue?DateTime.UtcNow.ToString():Model.StartDate.ToString())" 
                            type="datetime"/>
                            <span asp-validation-for="StartDate" class="text-danger"></span>

                        </div>
                        <div class="mb-3">
                            <button type="submit" class="btn btn-primary">@viewLocalizer["create"]</button>
                            <a asp-action="Index" class="btn btn-secondary">@viewLocalizer["cancel"]</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
    <partial name="_AlertBoxScript" />


}
