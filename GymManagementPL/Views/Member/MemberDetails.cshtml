@model MemberViewModel
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@inject IViewLocalizer viewLocalizer
@{
    ViewBag.Title = "Member Details";
    var Gender = Model.Gender == "Male" ? viewLocalizer["male"] : viewLocalizer["female"];
}


<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card card-details border-0 p-2 shadow">

                <div class="text-center mt-3">
                    <img src="~/images/Members/@(Model.Photo??"user.webp")" alt="@Model.Name" class="rounded-circle"
                         style="width: 120px; height: 120px; object-fit: cover; border: 3px solid #fff; margin-top: -60px;" />
                </div>

                <div class="card-body text-center">
                    <h2 class="mb-1 text-primary-color">@Model.Name</h2>

                    <h4 class="mb-2 pb-1 border-bottom d-block">
                        @(Model.PlanName ?? viewLocalizer["noActivePlans"].Value)
                    </h4>

                    <div class="mt-4 text-start">
                        <div class="row g-3">
                            <div class="col-12">
                                <div class="p-3 bg-light rounded">
                                    <small class="text-muted d-block mb-1">@viewLocalizer["email"]</small>
                                    <strong>@Model.Email</strong>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="p-3 bg-light rounded">
                                    <small class="text-muted d-block mb-1">@viewLocalizer["phone"]</small>
                                    <strong>@Model.Phone</strong>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 bg-light rounded">
                                    <small class="text-muted d-block mb-1">@viewLocalizer["gender"]</small>
                                    <strong>@(Gender)</strong>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 bg-light rounded">
                                    <small class="text-muted d-block mb-1">@viewLocalizer["dateofBirth"]</small>
                                    <strong>@Model.DateOfBirth</strong>
                                </div>
                            </div>
                            @if (Model.PlanName != null)
                            {
                                
                            
                            <div class="col-6">
                                <div class="p-3 bg-light rounded">
                                        <small class="text-muted d-block mb-1">@viewLocalizer["membershipStartDate"]</small>
                                    <strong>@Model.MembershipStartDate</strong>
                                </div>
                            </div>
                            <div class="col-6">
                                <div class="p-3 bg-light rounded">
                                        <small class="text-muted d-block mb-1">@viewLocalizer["membershipEndDate"]</small>
                                    <strong>@Model.MembershipEndDate</strong>
                                </div>
                            </div>
                            }

                            <div class="col-12">
                                <div class="p-3 bg-light rounded">
                                    <small class="text-muted d-block mb-1">@viewLocalizer["address"]</small>
                                    <strong dir="ltr"> @Model.Address</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-between gap-2 px-3 pb-3">
                    <a asp-controller="Member" asp-action="Index" class="btn btn-fill flex-fill">@viewLocalizer["backToList"]</a>
                </div>
            </div>
        </div>
    </div>
</div>