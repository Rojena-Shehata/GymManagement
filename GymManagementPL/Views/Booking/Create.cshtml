@model CreateBookingForSessionViewModel
@{
    ViewData["Title"] = "Create New Booking";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white text-center rounded-top-4">
                    <h4 class="mb-0">
                        <i class="fas fa-calendar-plus me-2"></i> @viewLocalizer["createBookingHeader"]
                    </h4>
                </div>
                <div class="text-danger">
                    @Html.ValidationMessage("DataMissed")
                </div>
                <div class="card-body p-4">
                    <form method="post" asp-action="Create" asp-route-sessionId="@Context.Request.Query["SessionId"]">
                        <dev></dev>
                        <div class="mb-4">
                            <label asp-for="memberId" class="form-label fw-semibold">
                                <i class="fas fa-user me-1"></i> @viewLocalizer["member"]
                            </label>
                            <select asp-for="memberId" class="form-select form-select-lg rounded-3" asp-items="ViewBag.Members">
                                <option value="">-- @viewLocalizer["selectMember"] --</option>
                            </select>
                            <span asp-validation-for="memberId" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="MemberPhone" class="form-label fw-semibold">
                                <i class="fas fa-phone-alt me-1"></i> @viewLocalizer["memberPhone"]

                            </label>
                            <input asp-for="MemberPhone" class="form-control form-control-lg rounded-3" placeholder="@viewLocalizer["memberPhonePlaceholder"].Value" />
                            <span  asp-validation-for="MemberPhone" class="text-danger"></span>
                        </div>
                        <div>
                            <input hidden readonly asp-for="SessionId" value="@ViewBag.SessionId" />
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="GetMembersForUpcomingSession" asp-controller="Booking" asp-route-sessionId="@Context.Request.Query["sessionId"]" class="btn btn-outline-secondary px-4 rounded-3">
                                <i class="fas fa-arrow-left me-1"></i> @viewLocalizer["backToList"]
                            </a>
                            <button type="submit" class="btn btn-primary px-4 rounded-3">
                                <i class="fas fa-save me-1"></i> @viewLocalizer["create"]
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
        $(document).ready(function () {
            $('select[name="memberId"]').select2({
                placeholder: "Select a member",
                allowClear: true,
                width: '100%'
            });
        });
    </script>
}
