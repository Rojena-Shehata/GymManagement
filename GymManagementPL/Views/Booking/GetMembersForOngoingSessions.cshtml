@model IEnumerable<MembersForOngoingSessionViewModel>
@{
    ViewData["Title"] = "Get Members For Ongoing Sessions";
}



@if (TempData["SuccessMessage"] is not null)
{

    <div id="Alert" class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] is not null)
{

    <div id="Alert" class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<header class="bg-primary text-white rounded-3 p-4 shadow-sm mt-5 mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="mb-1 fw-semibold">Session Members</h2>
            <p class="mb-0 text-light opacity-75">Members Attendance</p>
        </div>
    </div>
</header>
<div class="card shadow-sm">

    <div class="card-body">
        @if (Model is not null && Model.Any())
        {



            <table class="table table-striped table-hover align-middle text-center">
                <thead>
                    <tr>
                        <th>Member</th>
                        <th>phone</th>
                        <th>Booking Date</th>
                        <th>Attendance</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var bookedMember in Model)
                    {


                        <tr>
                            <td>@bookedMember.MemberName</td>
                            <td>@bookedMember.Phone</td>
                            <td>@bookedMember.BookingDate</td>
                            <td>
                                <div class="d-flex justify-content-center gap-1">
                                    <!-- If Member Attended -->
                                    @if (bookedMember.IsAttended)
                                    {

                                        <span class="text-success fw-bold">
                                            <i class="bi bi-check-circle me-1"></i> Attended
                                        </span>
                                    }
                                    else
                                    {

                                        <!-- If Member Not Attended -->
                                        <form method="post" asp-action="Attendance" 
                                        asp-route-sessionId="@bookedMember.SessionId" 
                                        asp-route-memberId="@bookedMember.MemberId"
                                        class="d-inline">

                                            <button type="submit" class="btn btn-outline-success btn-sm">
                                                <i class="bi bi-check-circle me-1"></i> Mark as Attended
                                            </button>
                                        </form>
                                    }
                                </div>
                    </td>
                </tr>
                }
            </tbody>
            </table>
        }
        else
        {
            
        
        <div class="text-center py-5">
            <i class="bi bi-person-workspace display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">No Members Available</h4>
        </div>
        }
    </div>
        
    <a asp-controller="booking" asp-action="Index" class="btn btn-fill ">Back to List</a>

</div>


@section  Scripts {
    <partial name="_AlertBoxScript" />
}