@model CreateMultipleBookingViewModel
@{
    ViewData["Title"] = "Create New Booking";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white text-center rounded-top-4">
                    <h4 class="mb-0"><i class="fas fa-calendar-plus me-2"></i> Create New Booking</h4>
                </div>
                <div class="card-body p-4">
                    <form method="post" asp-action="Create">
                        <!-- Member -->
                        <div class="mb-4">
                            <label asp-for="memberId" class="form-label fw-semibold">
                                <i class="fas fa-user me-1"></i> Member
                            </label>
                            <select asp-for="memberId" class="form-select form-select-lg rounded-3" asp-items="ViewBag.Members">
                                <option value="">-- Select Member --</option>
                            </select>
                            <span asp-validation-for="memberId" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Memberphone" class="form-label fw-semibold">
                                <i class="fas fa-phone-alt me-1"></i> Member Phone
                            </label>
                            <input asp-for="Memberphone" class="form-control form-control-lg rounded-3" placeholder="Enter member phone" />
                            <span asp-validation-for="Memberphone" class="text-danger"></span>

                        </div>

                        <!-- Buttons -->
                        <div class="d-flex justify-content-between mt-4">
                            <a asp-action="GetMembersForUpcomingSession" asp-controller="MemberSession" class="btn btn-outline-secondary px-4 rounded-3">
                                <i class="fas fa-arrow-left me-1"></i> Back
                            </a>
                            <button type="submit" class="btn btn-primary px-4 rounded-3">
                                <i class="fas fa-save me-1"></i> Save Booking
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
        $(document).ready(function () {
            $('select[name="memberId"]').select2({
                placeholder: "Select a member",
                allowClear: true,
                width: '100%'
            });
        });
    </script>
}
