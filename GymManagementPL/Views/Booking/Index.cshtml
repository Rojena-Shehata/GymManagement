@model IEnumerable<SessionViewModel>

@{
    ViewData["Title"] = "Sessions";
}

<div class="container">

    @if (Model != null && Model.Any())
    {

        <header class="d-flex justify-content-between mt-5 mb-4 align-items-center p-3 rounded-3 shadow-sm bg-light border-start border-4 border-primary">
            <div>
                <h2 class="text-primary fw-bold mb-1">
                    <i class="bi bi-journal-bookmark-fill me-2"></i>
                    @viewLocalizer["BookingIndexTitle"]
                </h2>
                <p class="text-secondary mb-0">
                    @viewLocalizer["sessionsSubtitleUpcoming"]
                </p>
            </div>
        </header>

        <div class="row g-4 ">
            @foreach (var session in Model.Where(X => X.Status == "Upcoming"))
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 session-card">
                        <div class="card-header text-white py-3 bg-primary ">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">
                                    <i class="bi bi-calendar-event me-2"></i>@session.CategoryName
                                </h5>
                                <span class="badge bg-light text-dark">@session.Status</span>
                            </div>
                        </div>
                        <div class="card-body">
                            <p class="text-muted mb-3">@session.Description</p>

                            <div class="session-info mb-3">
                                <div class="info-item mb-2">
                                    <i class="bi bi-person-circle text-primary-color me-2"></i>
                                    <strong>@viewLocalizer["theTrainer"]:</strong> @session.TrainerName
                                </div>
                                <div class="info-item mb-2">
                                    <i class="bi bi-calendar3 text-primary-color me-2"></i>
                                    <strong>@viewLocalizer["date"]:</strong> @session.DateDisplay
                                </div>
                                <div class="info-item mb-2">
                                    <i class="bi bi-clock text-primary-color me-2"></i>
                                    <strong>@viewLocalizer["time"]:</strong> @session.TimeRangeDisplay
                                </div>
                                <div class="info-item mb-2">
                                    <i class="bi bi-hourglass-split text-primary-color me-2"></i>
                                    <strong>@viewLocalizer["duration"]:</strong> @session.Duration
                                </div>
                                <div class="info-item">
                                    <i class="bi bi-people text-primary-color me-2"></i>
                                    <strong>@viewLocalizer["capacity"]:</strong> @session.AvailableSlots/@session.Capacity @viewLocalizer["slots"]
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-white border-0">
                            <div class="d-grid gap-2">
                                <a asp-controller="Booking"  asp-action="GetMembersForUpcomingSession" asp-route-SessionId="@session.Id" class="btn btn-outline btn-sm">
                                    <i class="bi bi-eye me-1"></i> @viewLocalizer["viewMembers"]
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>
    
        <header class="d-flex justify-content-between mt-5 mb-4 align-items-center p-3 rounded-3 shadow-sm bg-light border-start border-4 border-success">
            <div>
                <h2 class="text-success fw-bold mb-1">
                    <i class="bi bi-clipboard-check-fill me-2"></i>
                    @viewLocalizer["BookingIndexTitle"]
                </h2>
                <p class="text-secondary mb-0">
                    @viewLocalizer["sessionsSubtitleOngoing"]
                </p>
            </div>
        </header>

        <div class="row g-4 ">
            @foreach (var session in Model.Where(X => X.Status == "Ongoing"))
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 session-card">
                        <div class="card-header text-white py-3 bg-success ">
                            <div class="d-flex justify-content-between align-items-center">
                                <h5 class="mb-0">
                                    <i class="bi bi-calendar-event me-2"></i>@session.CategoryName
                                </h5>
                                <span class="badge bg-light text-dark">@session.Status</span>
                            </div>
                        </div>
                        <div class="card-body">
                            <p class="text-muted mb-3">@session.Description</p>

                            <div class="session-info mb-3">
                                <div class="info-item mb-2">
                                    <i class="bi bi-person-circle text-primary-color me-2"></i>
                                    <strong>@viewLocalizer["theTrainer"]:</strong> @session.TrainerName
                                </div>
                                <div class="info-item mb-2">
                                    <i class="bi bi-calendar3 text-primary-color me-2"></i>
                                    <strong>@viewLocalizer["date"]:</strong> @session.DateDisplay
                                </div>
                                <div class="info-item mb-2">
                                    <i class="bi bi-clock text-primary-color me-2"></i>
                                    <strong>@viewLocalizer["time"]:</strong> @session.TimeRangeDisplay
                                </div>
                                <div class="info-item mb-2">
                                    <i class="bi bi-hourglass-split text-primary-color me-2"></i>
                                    <strong>@viewLocalizer["duration"]:</strong> @session.Duration
                                </div>
                                <div class="info-item">
                                    <i class="bi bi-people text-primary-color me-2"></i>
                                    <strong>@viewLocalizer["capacity"]:</strong> @session.AvailableSlots/@session.Capacity @viewLocalizer["slots"]
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-white border-0">
                            <div class="d-grid gap-2">
                                <a asp-action="GetMembersForOngoingSessions" asp-route-sessionId="@session.Id" class="btn btn-outline btn-sm">
                                    <i class="bi bi-eye me-1"></i> @viewLocalizer["viewMembers"]
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-calendar-x display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">@viewLocalizer["noSessions"]</h4>
            <p class="text-muted">@viewLocalizer["addFirstSession"]</p>
        </div>
    }
</div>
