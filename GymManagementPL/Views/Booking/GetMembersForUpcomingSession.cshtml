@model IEnumerable<MembersForUpcomigSessionViewModel>
@{
    ViewData["Title"] = "Session Members";
}
@if (TempData["SuccessMessage"] is not null)
{

    <div id="Alert" class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle-fill me-2"></i>
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] is not null)
{

    <div id="Alert" class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
<header class="bg-primary text-white rounded-3 p-4 shadow-sm mt-5 mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h2 class="mb-1 fw-semibold">@viewLocalizer["sessionMembersTitle"]</h2>
            <p class="mb-0 text-light opacity-75">@viewLocalizer["sessionMembersSubtitle"]</p>
        </div>
        <div class="text-end">
            <a asp-action="Create" asp-controller="Booking" asp-route-sessionId="@Context.Request.Query["SessionId"]" class="btn btn-light">
                <i class="fas fa-plus me-1"></i> @viewLocalizer["newBooking"]
            </a>
        </div>
    </div>
</header>
 

<div class="card shadow-sm">

    <div class="card-body">
        @if (Model is not null && Model.Any())
        {

            <table class="table table-striped table-hover align-middle text-center">
                <thead>
                    <tr>
                        <th>@viewLocalizer["member"]</th>
                        <th>@viewLocalizer["phone"]</th>
                        <th>@viewLocalizer["bookingDate"]</th>
                        <th>@viewLocalizer["actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var BookedMember in Model)
                    {


                        <tr>
                            <td>@BookedMember.MemberName</td>
                            <td>@BookedMember.Phone</td>
                            <td>@BookedMember.BookingDate</td>
                            <td>
                                <div class="d-flex justify-content-center gap-1">
                                    <form method="post" asp-controller="Booking" 
                                        asp-action="Cancel" 
                                        asp-route-sessionId="@BookedMember.SessionId"
                                        asp-route-memberId="@BookedMember.MemberId" class="m-0">
                                        <button type="submit" class="btn btn-sm btn-danger"
                                                onclick="return confirm('@viewLocalizer["cancelBookingConfirm"].Value');">
                                            <i class="fas fa-times"></i> @viewLocalizer["cancel"]
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {


            <div class="text-center py-5">
                <i class="bi bi-person-workspace display-1 text-muted"></i>
                <h4 class="mt-3 text-muted">@viewLocalizer["noBookingsTitle"]</h4>
                <p class="text-muted">@viewLocalizer["noBookingsSubtitle"]</p>
            </div>
        }
    </div>

    <a asp-controller="booking" asp-action="Index" class="btn btn-fill ">@viewLocalizer["backToList"]</a>

</div>

@section  Scripts{
    <partial name="_AlertBoxScript" />
}