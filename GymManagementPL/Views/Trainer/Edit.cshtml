@model TrainerToUpdateViewModel
@{
    ViewData["Title"] = $"Edit {Model.Name} Trainer";
}


<div class="container mt-4">
    <header class="mb-4">
        <h3 class="text-primary-color">@viewLocalizer["editTrainerTitle"]</h3>
        <p class="text-muted">@viewLocalizer["editTrainerSubtitle"]</p>
    </header>

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="mb-4 pb-3 border-bottom">
                        <small class="text-muted d-block mb-1">@viewLocalizer["editingProfileFor"]</small>
                        <h4 class="mb-0 text-black">@Model.Name</h4>
                    </div>
                    <form asp-action="Edit" asp-controller="Trainer" method="post">
                        <!-- Personal Information -->
                        <input hidden readonly asp-for="Name" />
                        <div class="section-header mb-3">
                            <h5 class="text-primary fw-bold">@viewLocalizer["personalInformation"]</h5>
                            <hr class="mt-2">
                        </div>
                        <div class="row g-3 mb-4">


                            <div class="col-md-6">
                                <label asp-for="Email" class="form-label">@viewLocalizer["email"] </label>
                                <input asp-for="Email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger"></span>

                            </div>

                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label">@viewLocalizer["phone"]</label>
                                <input asp-for="Phone" type="text" class="form-control" />
                                <span asp-validation-for="Phone" class="text-danger"></span>

                            </div>
                            <div class="col-md-6">
                                <label asp-for="BuildingNumber" class="form-label">@viewLocalizer["buildingNumber"]</label>
                                <input asp-for="BuildingNumber"class="form-control" />
                                <span asp-validation-for="BuildingNumber" class="text-danger"></span>

                            </div>
                            <div class="col-md-6">
                                <label asp-for="Street" class="form-label">@viewLocalizer["street"]</label>
                                <input asp-for="Street" type="text" class="form-control" />
                                <span asp-validation-for="Street" class="text-danger"></span>

                            </div>
                            <div class="col-md-6">
                                <label asp-for="City" class="form-label">@viewLocalizer["city"]</label>
                                <input asp-for="City" type="text" class="form-control" />
                                <span asp-validation-for="City" class="text-danger"></span>

                            </div>
                        </div>

                        <!-- Professional Information -->
                        <div class="section-header mb-3">
                            <h5 class="text-primary fw-bold">@viewLocalizer["professionalInfo"]</h5>
                            <hr class="mt-2">
                        </div>
                        <div class="row g-3">

                            <div class="col-12">
                                <label class="form-label fw-semibold">
                                    Specializations <span class="text-danger">*</span>
                                </label>
                                
                <div class="form-check">

                                    @foreach (var item in Html.GetEnumSelectList<Specialties>())
                                    {
                                        <div class="form-check">

                                            <input name="Specialization"  class="form-check-input" type="radio"
                                                   value="@item.Value" 
                                                   @(item.Value == ((int)Model.Specialization).ToString() ? "checked='checked'" : "") />
                                            <label asp-for="Specialization" class="form-check-label">@item.Text</label>
                                        </div>
                                    }
                            </div>
                        </div>

                        <div class="d-flex justify-content-between mt-4 pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline">
                                <i class="bi bi-arrow-left me-1"></i>@viewLocalizer["cancel"]
                            </a>
                            <button type="submit" class="btn btn-fill">
                                <i class="bi bi-check-lg me-1"></i>@viewLocalizer["edit"]
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial"></partial>
}