
@{
    ViewData["Title"] = "Confirm Delete Trainer";
}


<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card p-5 shadow text-center">

                <p class="fs-3 text-primary-color mb-4">
                    @viewLocalizer["deleteConfirmQuestion", viewLocalizer["theTrainer"]]
                </p>

                <div class="alert alert-warning text-start" role="alert">
                    <strong>@viewLocalizer["warning"]!</strong> @viewLocalizer["deleteActionMessage", viewLocalizer["theTrainer"]]
                </div>

                <form asp-action="DeleteConfirmed" asp-controller="Trainer" method="post" class="mt-4">
                    <input type="hidden" name="id" value="@ViewBag.TrainerId" readonly />
                    <div class="buttons d-flex justify-content-between gap-3">
                        <a asp-controller="Trainer" asp-action="Index" class="btn-outline flex-fill">@viewLocalizer["no"]</a>
                        <button type="submit" class="btn-fill flex-fill">@viewLocalizer["yes"]</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
